APP_NAME=Laravel
APP_ENV=install
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS="${APP_URL}"
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_SUPPORTS_CREDENTIALS=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VOD_DISK=vod-master
VOD_MAX_UPLOAD_SIZE=10485760

STREAM_ALLOWED_SCHEMES=https,http
STREAM_ALLOWED_PORTS=80,443,1935
STREAM_MAX_URL_LENGTH=2048

STREAM_MONITOR_ALLOWED_PORTS=80,443,1935
STREAM_MONITOR_BLOCK_LOCALHOST=true
STREAM_MONITOR_BLOCK_PRIVATE_IPS=true
STREAM_MONITOR_BLOCK_CLOUD_METADATA=true
STREAM_MONITOR_MAX_REDIRECTS=3
STREAM_MONITOR_CONNECT_TIMEOUT=5
STREAM_MONITOR_REQUEST_TIMEOUT=10
STREAM_MONITOR_MAX_RESPONSE_BYTES=1048576

MODULE_CUSTOMER_ENABLED=true
MODULE_VOD_ENABLED=true
MODULE_EPG_ENABLED=false
EPG_REQUEST_TIMEOUT=15
EPG_CONNECT_TIMEOUT=5
EPG_MAX_REDIRECTS=3
EPG_JOB_TIMEOUT=1800
EPG_SYNC_LOCK_SECONDS=3600
EPG_ERROR_RETRY_MINUTES=15
EPG_HTTP_CACHE_SECONDS=300
EPG_RATE_LIMIT_PER_MINUTE=30
EPG_QUEUE_CONNECTION=database
EPG_QUEUE=epg
DATABASE_QUEUE_RETRY_AFTER=2100
EPG_MAX_DOWNLOAD_BYTES=52428800
EPG_MAX_UNCOMPRESSED_BYTES=52428800
EPG_MAX_PROGRAMMES_PER_IMPORT=500000
EPG_RETENTION_DAYS=7
EPG_DEFAULT_TIMEZONE=UTC
